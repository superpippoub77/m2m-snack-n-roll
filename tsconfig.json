{
  "compilerOptions": {
    "jsx": "react",
    "target": "es5",
    "lib": ["dom", "es2015"],
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "types": ["phaser"]
  },
  "include": [
    "src/**/*"
  ]
}

